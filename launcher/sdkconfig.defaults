# Fixed 16MB flash; auto-detect sets --flash_size detect in flash_args, which breaks idf.py qemu merge_bin.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

# ESPlay Micro (pebri86/esplay_micro_hardware): BCK=IO26, WS(LCK)=IO25, DIN=IO19.
# DOUT must match I2S DIN on the DAC (GPIO 4 is wrong for stock ESPlay Micro → no audio).
CONFIG_AUDIO_I2S_BCLK_GPIO=26
CONFIG_AUDIO_I2S_WS_GPIO=25
CONFIG_AUDIO_I2S_DOUT_GPIO=19
# GPIO 4 = AMP_SHDN on stock ESPlay Micro / ESPlay 2.0 (esplay-hal); high = speaker on.
CONFIG_AUDIO_AMP_GPIO=4

# No WiFi AP / HTTP file server — keeps wpa_supplicant, lwip, TLS out of the build.
CONFIG_ESP_WIFI_ENABLED=n

# UTF-8 paths for non-ASCII (e.g. Japanese) long filenames on SD FAT.
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_LFN_HEAP=y

# LVGL: use libc heap so large directory lists don't exhaust a fixed pool.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
# Launcher does not use LVGL examples/demos; keep them out to avoid huge Windows ar archives.
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_BMP=y
