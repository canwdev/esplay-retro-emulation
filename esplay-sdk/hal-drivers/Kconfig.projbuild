menu "Hardware configuration"

choice EMULATOR_HARDWARE
	prompt "Hardware to run on"
	default ESPLAY_MICRO_HW
	help
		This emulator can run on various types of hardware. Select what you have here.

config ESPLAY20_HW
	bool "ESPlay 2.0 Hardware"

config ESPLAY_MICRO_HW
	bool "ESPlay Micro Hardware"

config HW_CUSTOM
	bool "Custom hardware"

endchoice

choice HW_LCD_TYPE_SEL
	prompt "LCD type"
	default HW_LCD_TYPE_ILI9341
	depends on HW_CUSTOM

config HW_LCD_TYPE_ILI9341
	bool "ILI9341 LCD"

config HW_LCD_TYPE_ILI9342
	bool "ILI9342 LCD"

endchoice

config HW_LCD_TYPE
	int
	default 0 if ESPLAY20_HW
  default 0 if ESPLAY_MICRO_HW
	default 0 if HW_LCD_TYPE_ILI9341
	default 1 if HW_LCD_TYPE_ILI9342

endmenu

menu "Audio I2S speaker"

config AUDIO_I2S_BCLK_GPIO
	int "I2S bit clock (BCLK) GPIO"
	default 26
	range 0 39

config AUDIO_I2S_WS_GPIO
	int "I2S word select (LRCK/WS) GPIO"
	default 25
	range 0 39

config AUDIO_I2S_DOUT_GPIO
	int "I2S data out (DOUT) GPIO"
	default 19
	range 0 39
	help
	  ESPlay Micro (UDA1334): ESP32 IO19 → DAC DIN. Change if your wiring differs.

config AUDIO_AMP_GPIO
	int "Internal speaker amp enable GPIO (-1 = none)"
	default 4
	range -1 39
	help
	  Legacy ESPlay / ESPlay Micro (see esplay-hal pin_definitions): GPIO 4 high enables
	  PAM8403 (external speaker). Headphones work without this. Use -1 if your board has no SHDN line.

endmenu